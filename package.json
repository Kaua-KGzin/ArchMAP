{
  "name": "archmap",
  "version": "1.0.2",
  "description": "Static architecture analysis and visualization for software projects — dependency graphs, cycle detection, risk scoring, LLM advisor.",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "python -m archmap.cli.main analyze .",
    "serve": "python -m archmap.cli.main serve .",
    "serve:web": "node web-ui/dev-server.js .",
    "diff": "python -m archmap.cli.main diff HEAD~1 HEAD",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/demo.ps1",
    "test": "python -m pytest -q",
    "lint": "python -m ruff check .",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "check": "npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "archmap",
    "architecture",
    "dependency-graph",
    "visualization",
    "cytoscape",
    "mermaid"
  ],
  "author": "Kaua-KGzin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaua-KGzin/ArchMAP.git"
  },
  "bugs": {
    "url": "https://github.com/Kaua-KGzin/ArchMAP/issues"
  },
  "homepage": "https://github.com/Kaua-KGzin/ArchMAP#readme",
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "fast-glob": "^3.3.3"
  }
}
